{
    "dockerComposeFile": [
        "../docker-compose.yml",
        "docker-compose.extend.yml"
    ],
    "service": "python",
    "workspaceFolder": "/app",
    "remoteUser": "vscode",
    "postCreateCommand": "uv sync --extra dev && uv tool install tox --with tox-uv",
    "customizations": {
        "vscode": {
            "extensions": [
                "charliermarsh.ruff",
                "tamasfe.even-better-toml"
            ]
        }
    }
}